  },
  "keywords": ["haxball", "sdk", "nodejs", "puppeteer"],
  "author": "Lauto5",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "puppeteer-core": "^24.x"
  }
}
