{
  "name": "haxball-host-sdk",
  "version": "1.0.0",
  "description": "Advanced Node.js SDK for managing HaxBall headless hosts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
