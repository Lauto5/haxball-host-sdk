{
  "name": "haxball-host-sdk",
  "version": "1.0.0",
  "description": "Advanced Node.js SDK for managing HaxBall headless hosts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "npx ts-node dev/index.ts",
    "dev": "ts-node-dev --respawn --transpile-only dev/index.ts",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "haxball",
    "sdk",
    "nodejs",
    "puppeteer"
  ],
  "author": "Lauto5",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "puppeteer": "^24.42.0",
    "puppeteer-core": "^24.42.0"
  }
}
